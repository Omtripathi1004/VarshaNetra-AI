{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/send-sms",
      "dest": "/api/send-sms.js"
    },
    {
      "src": "/api/send-email",
      "dest": "/api/send-email.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py?_path=/$1"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py?_path=/docs"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py?_path=/openapi.json"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
