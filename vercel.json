{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/send-sms",
      "destination": "/api/send-sms.js"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_path=/$1"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?_path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?_path=/openapi.json"
    }
  ]
}
