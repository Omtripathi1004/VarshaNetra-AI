{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/send-sms",
      "destination": "/api/send-sms.js"
    },
    {
      "source": "/api/send-sms/(.*)",
      "destination": "/api/send-sms.js"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/api/send-email/(.*)",
      "destination": "/api/send-email.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
