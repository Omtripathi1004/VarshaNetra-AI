{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/app/**"]
      }
    },
    {
      "src": "api/send-sms.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/send-email.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/send-sms",
      "dest": "/api/send-sms.js"
    },
    {
      "src": "/api/send-email",
      "dest": "/api/send-email.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/index.py?_path=/health"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py?_path=/$1"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py?_path=/docs"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py?_path=/openapi.json"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
