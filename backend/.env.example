# VarshaNetra AI — Environment Configuration Template
# Copy this file to .env and fill in the required credentials.

# Notification Delivery Mode (False = real provider delivery, True = simulation only)
NOTIFICATION_MOCK=False

# SMS Provider Selection ('TWILIO' | 'FAST2SMS')
PRIMARY_SMS_PROVIDER=TWILIO
SECONDARY_SMS_PROVIDER=FAST2SMS

# Twilio SMS Credentials (or use TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Fast2SMS API Key (Indian Telecom Route)
FAST2SMS_API_KEY=

# Gmail / Custom SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional HTTP Email Gateways
RESEND_API_KEY=
BREVO_API_KEY=

# Google Gemini AI (Chatbot LLM — free tier works fine)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
