# MapTiler API Key for MapLibre Vector Map Engine (optional, used for satellite/hybrid fallback)
VITE_MAPTILER_API_KEY=

# MapmyIndia / Mappls API Key — Primary Indian Map Provider (get yours at https://auth.mappls.com/console)
VITE_MAPPLS_API_KEY=


# VarshaNetra Backend Environment Configuration
NOTIFICATION_MOCK=False

# Gmail SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Twilio SMS Settings (Optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
